<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (!project) { %>
        <p>Service project not found.</p>
        <p>Return to the <a href="/projects">projects list</a>.</p>
    <% } else {
        const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
    %>
        <h2><%= project.title %></h2>
        <p><strong>Date:</strong> <%= formattedDate %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
        <p><%= project.description %></p>
    <% } %>
</main>

<%- include('partials/footer') %>
