<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= organizationDetails.name %></h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
    <p><%= organizationDetails.description %></p>
    <p>Contact: <%= organizationDetails.contact_email %></p>

    <h3>Service Projects</h3>
    <% if (projects.length === 0) { %>
        <p>No service projects available for this organization yet.</p>
    <% } else { %>
        <ul>
            <% projects.forEach(project => {
                const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
            %>
                <li>
                    <%= formattedDate %>:
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }) %>
        </ul>
    <% } %>
</main>

<%- include('partials/footer') %>
